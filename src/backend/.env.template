# copy this file and then rename it to .env file.
# Replace the 192.168.50.102 to your IP
# Replace the Housekeeper Bee API key to your API key
# Replace the Ollama API Key to your API key

NODE_ENV=production
PORT=3801
HOUSEKEEPER_BEE_API_URL='https://192.168.50.102:8443'
HOUSEKEEPER_BEE_RETURN_URL='https://192.168.50.102:8443/locations/all'
HOUSEKEEPER_BEE_API_KEY='Your_Housekeeper_Bee_API_Key'

API_URL='https://192.168.50.102:3801'
ALLOWED_ORIGINS='https://192.168.50.102:5173,http://192.168.50.102:3800,https://192.168.50.102:3801,192.168.50.102:8443,https://192.168.50.102:3843'

# show on AI Processor logging database 
CLIENT_ID=Housekeeper Bee Report Server

# AI generation parameters
AI_TEMPERATURE=0.1
AI_TOP_P=0.95
AI_SEED=42
AI_TOP_K=20
AI_NUM_PREDICT=4096
AI_REPEAT_PENALTY=1.05

# ─── AI Engine Selection ──────────────────────────────────────────────────────
# Choose one: ollama_cloud | ollama_local | ai_processor
AI_ENGINE=ollama_cloud
AI_REQUEST_TIMEOUT_MS=900000   # 15 minutes (default)

# ─── ai_processor ─────────────────────────────────────────────────────────────
# Remote AI Processor server running on your 32GB PC
# AI_ENGINE=ai_processor
# AI_PROCESSOR_URL='http://192.168.1.100:3000/api/v1/'
# AI_PROCESSOR_KEY=mysecretkey          # leave blank if auth is disabled
# AI_PROCESSOR_MODE=coder               # coder | thinking | default
# AI_CONTEXT_WINDOW=4096                # 16GB System RAM 16384 

# ─── ollama_cloud ─────────────────────────────────────────────────────────────
# Ollama Configuration
OLLAMA_API='https://ollama.com'
OLLAMA_API_KEY='your_api_key_here'
OLLAMA_MODEL='gpt-oss:120b-cloud'

# ─── ollama_local ─────────────────────────────────────────────────────────────
# Ollama running on the same machine as the report generator (no auth needed)
# OLLAMA_API=http://localhost:11434
# OLLAMA_MODEL=llama3.2
